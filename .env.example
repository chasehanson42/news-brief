# Copy to .env for local runs (never commit .env). In GitHub, add these as repository secrets.

# Free LLM keys. Only GEMINI_API_KEY is needed; the other two are backups.
# Gemini: aistudio.google.com > Get API key
GEMINI_API_KEY=
# Groq: console.groq.com > API Keys
GROQ_API_KEY=
# OpenRouter: openrouter.ai > Keys
OPENROUTER_API_KEY=

# Free news keys (optional)
NYT_API_KEY=
GUARDIAN_API_KEY=

# Gmail: use an App Password (Google Account > Security > App passwords), not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
EMAIL_TO=you@gmail.com
